{
  "name": "ranch-hand-trail-sweeper",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "ibuchanan",
  "type": "module",
  "scripts": {
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "run-p --npm-path bun --print-label \"{lint,test,size:check,pack:check}\"",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "run-p --npm-path bun --print-label \"lint:check:*\"",
    "lint:check:biome": "biome lint",
    "lint:check:format": "bun run format:check",
    "lint:check:skills": "check-skill --all",
    "lint:check:typecheck": "bun run typecheck",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" && cspell lint \"**/*.md\"",
    "lint:fix": "biome lint --write",
    "prepare": "lefthook install || true",
    "release": "bash scripts/release.sh",
    "release:check": "bun run test && bun run typecheck",
    "skill:list": "bun run src/scripts/list-skills.ts",
    "skill:new": "init-skill",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch --pass-with-no-tests",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.2",
    "agent-skills-toolkit": "github:ibuchanan/agent-skills-toolkit",
    "cspell": "10.4.0",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "npm-run-all2": "9.0.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
